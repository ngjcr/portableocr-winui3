<Window
    x:Class="PortableOCR.WinUI3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:PortableOCR.WinUI3.Models"
    mc:Ignorable="d"
    Title="PortableOCR">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt"/>
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="Transparent" AllowDrop="True" DragOver="RootGrid_DragOver" DragLeave="RootGrid_DragLeave" Drop="RootGrid_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,138,0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="26" Height="26" CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="White"/>
                </Border>
                <TextBlock Text="PortableOCR" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Border Padding="7,2" CornerRadius="6" Background="{ThemeResource AppSurfaceSubtleBrush}" BorderBrush="{ThemeResource AppStrokeBrush}" BorderThickness="1">
                    <TextBlock Text="WINUI 3" FontSize="9" FontWeight="SemiBold" CharacterSpacing="110"/>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button x:Name="OpenDesktopButton" Style="{StaticResource SoftButtonStyle}" Click="OpenDesktop_Click" ToolTipService.ToolTip="Open Desktop">
                    <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE8B7;" FontSize="13"/><TextBlock Text="Desktop"/></StackPanel>
                </Button>
                <Button x:Name="SettingsButton" Style="{StaticResource IconButtonStyle}" Click="Settings_Click" ToolTipService.ToolTip="Settings">
                    <FontIcon Glyph="&#xE713;" FontSize="15"/>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="14,0,14,14" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="490" MinWidth="430"/>
                <ColumnDefinition Width="*" MinWidth="460"/>
            </Grid.ColumnDefinitions>

            <!-- Left workspace -->
            <Grid Grid.Column="0" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Padding="6,8,6,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="DOCUMENT WORKSPACE" FontSize="10" FontWeight="SemiBold" CharacterSpacing="100" Foreground="{ThemeResource AppTextTertiaryBrush}"/>
                        <TextBlock Text="PortableOCR" FontSize="28" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse Width="6" Height="6" Fill="{ThemeResource SuccessBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Outputs save to Desktop" FontSize="11" Foreground="{ThemeResource AppTextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource SoftButtonStyle}" Click="AddFiles_Click" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE710;" FontSize="13"/><TextBlock Text="Add files"/></StackPanel>
                    </Button>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="8">
                    <Grid>
                        <Grid x:Name="EmptyState" Visibility="Visible" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <StackPanel Width="300" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="118" Height="94">
                                    <Border Width="72" Height="88" CornerRadius="13" Background="{ThemeResource AppSurfaceStrongBrush}" BorderBrush="{ThemeResource AppStrokeBrush}" BorderThickness="1" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform><RotateTransform Angle="-5"/></Border.RenderTransform>
                                    </Border>
                                    <Border Width="72" Height="88" CornerRadius="13" Background="{ThemeResource AppSurfaceStrongBrush}" BorderBrush="{ThemeResource AppStrokeBrush}" BorderThickness="1" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform><RotateTransform Angle="5"/></Border.RenderTransform>
                                    </Border>
                                    <Border Width="74" Height="90" CornerRadius="13" Background="{ThemeResource AppSurfaceStrongBrush}" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1.5" HorizontalAlignment="Center">
                                        <StackPanel Padding="13,16" Spacing="7"><Rectangle Height="4" RadiusX="2" RadiusY="2" Fill="{ThemeResource AccentFillColorDefaultBrush}"/><Rectangle Height="3" RadiusX="2" RadiusY="2" Fill="{ThemeResource AppStrokeBrush}"/><Rectangle Height="3" RadiusX="2" RadiusY="2" Fill="{ThemeResource AppStrokeBrush}"/><Rectangle Height="3" RadiusX="2" RadiusY="2" Fill="{ThemeResource AppStrokeBrush}"/></StackPanel>
                                    </Border>
                                </Grid>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Drop documents anywhere" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="PDF · JPG · PNG · TIFF · BMP · WEBP · GIF" FontSize="11" Foreground="{ThemeResource AppTextTertiaryBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <Button Content="Choose files" Click="AddFiles_Click" HorizontalAlignment="Center" Style="{StaticResource SoftButtonStyle}"/>
                                <TextBlock Text="or press Ctrl+O" FontSize="10" Foreground="{ThemeResource AppTextTertiaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="QueueState" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Margin="8,5,8,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="QUEUE" FontSize="10" FontWeight="SemiBold" CharacterSpacing="100"/><TextBlock x:Name="QueueCountText" FontSize="10" Foreground="{ThemeResource AppTextTertiaryBrush}"/></StackPanel>
                                <Button Grid.Column="1" Content="Clear" Background="Transparent" BorderThickness="0" Click="ClearQueue_Click" Padding="8,2"/>
                            </Grid>
                            <ListView x:Name="QueueList" Grid.Row="1" ItemsSource="{x:Bind Documents}" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="QueueList_ItemClick" SelectionChanged="QueueList_SelectionChanged" Background="Transparent">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,7"/>
                                        <Setter Property="CornerRadius" Value="14"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:OcrDocument">
                                        <Grid MinHeight="82" Padding="10" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Border Width="62" Height="62" CornerRadius="10" Background="{ThemeResource AppSurfaceSubtleBrush}" BorderBrush="{ThemeResource AppStrokeBrush}" BorderThickness="1">
                                                <Grid>
                                                    <FontIcon Glyph="{x:Bind FileGlyph, Mode=OneWay}" FontSize="24" Foreground="{ThemeResource AppTextSecondaryBrush}"/>
                                                    <Image Source="{x:Bind ThumbnailSource, Mode=OneWay}" Stretch="UniformToFill"/>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Path}"/>
                                                <TextBlock Text="{x:Bind Meta, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource AppTextTertiaryBrush}"/>
                                                <TextBlock Text="{x:Bind Substatus, Mode=OneWay}" FontSize="10.5" Foreground="{ThemeResource AppTextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" Maximum="100" Height="2" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Border Visibility="{x:Bind QualityVisibility, Mode=OneWay}" Background="{ThemeResource AppSurfaceSubtleBrush}" BorderBrush="{ThemeResource AppStrokeBrush}" BorderThickness="1" CornerRadius="7" Padding="7,3">
                                                    <TextBlock Text="{x:Bind QualityLabel, Mode=OneWay}" FontSize="9"/>
                                                </Border>
                                                <FontIcon Glyph="{x:Bind StatusGlyph, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource AppTextSecondaryBrush}" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="14">
                    <StackPanel Spacing="12">
                        <Grid>
                            <StackPanel Spacing="2"><TextBlock Text="OCR PROFILE" FontSize="10" FontWeight="SemiBold" CharacterSpacing="100"/><TextBlock x:Name="QualityDescription" Text="Balanced · cleans scans and uses 300 DPI for PDFs" FontSize="10" Foreground="{ThemeResource AppTextTertiaryBrush}"/></StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="8" Padding="8,3"><TextBlock x:Name="QualityBadge" Text="BALANCED" FontSize="9" FontWeight="SemiBold"/></Border>
                        </Grid>
                        <Grid ColumnSpacing="7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <ToggleButton x:Name="FastProfile" Style="{StaticResource ProfileToggleStyle}" Click="Profile_Click" Tag="fast"><StackPanel><TextBlock Text="Fast" FontWeight="SemiBold"/><TextBlock Text="clean scans" FontSize="10" Foreground="{ThemeResource AppTextTertiaryBrush}"/></StackPanel></ToggleButton>
                            <ToggleButton x:Name="BalancedProfile" Grid.Column="1" Style="{StaticResource ProfileToggleStyle}" Click="Profile_Click" Tag="balanced" IsChecked="True"><StackPanel><TextBlock Text="Balanced" FontWeight="SemiBold"/><TextBlock Text="everyday" FontSize="10" Foreground="{ThemeResource AppTextTertiaryBrush}"/></StackPanel></ToggleButton>
                            <ToggleButton x:Name="BestProfile" Grid.Column="2" Style="{StaticResource ProfileToggleStyle}" Click="Profile_Click" Tag="best"><StackPanel><TextBlock Text="Best" FontWeight="SemiBold"/><TextBlock Text="difficult pages" FontSize="10" Foreground="{ThemeResource AppTextTertiaryBrush}"/></StackPanel></ToggleButton>
                        </Grid>
                        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="6"><TextBlock Text="OUTPUT" FontSize="10" FontWeight="SemiBold" CharacterSpacing="100"/><StackPanel Orientation="Horizontal" Spacing="8"><ToggleButton x:Name="TextOutputToggle" Content="Text" IsChecked="True" Click="Output_Click"/><ToggleButton x:Name="PdfOutputToggle" Content="Searchable PDF" IsChecked="True" Click="Output_Click"/></StackPanel></StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="AUTO CLEAR" FontSize="10" FontWeight="SemiBold" CharacterSpacing="100"/><ToggleSwitch x:Name="AutoClearToggle" Header="Remove completed files" Toggled="AutoClear_Toggled"/></StackPanel>
                        </Grid>
                        <Grid RowSpacing="7"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid><StackPanel><TextBlock x:Name="StatusTitle" Text="Ready" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="StatusDetail" Text="Add an image or PDF to begin." FontSize="10" Foreground="{ThemeResource AppTextTertiaryBrush}" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock x:Name="ProgressText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="{ThemeResource AppTextTertiaryBrush}"/></Grid>
                            <ProgressBar x:Name="OverallProgress" Grid.Row="1" Maximum="100" Value="0" Height="4"/>
                            <Grid Grid.Row="2"><Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Visibility="Collapsed"/><Button x:Name="RunButton" HorizontalAlignment="Right" Style="{StaticResource SoftButtonStyle}" Click="Run_Click" IsEnabled="False"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Run OCR" FontWeight="SemiBold"/><FontIcon Glyph="&#xE768;" FontSize="12"/></StackPanel></Button></Grid>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Preview -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid x:Name="PreviewEmpty">
                        <StackPanel Width="360" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                            <Border Width="86" Height="86" CornerRadius="26" Background="{ThemeResource AppSurfaceSubtleBrush}" BorderBrush="{ThemeResource AppStrokeBrush}" BorderThickness="1" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xEA90;" FontSize="32" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                            </Border>
                            <TextBlock Text="Document preview" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Select a file to inspect pages, preparation, and recognized text." TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource AppTextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="PreviewActive" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
                        <Grid Padding="14,8" BorderBrush="{ThemeResource AppStrokeBrush}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center"><TextBlock x:Name="PreviewName" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="PreviewMeta" FontSize="10" Foreground="{ThemeResource AppTextTertiaryBrush}"/></StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <ToggleButton x:Name="PreparedToggle" Content="Prepared" Click="Prepared_Click"/>
                                <ToggleButton x:Name="OverlayToggle" Content="Overlay" Click="Overlay_Click" IsEnabled="False"/>
                                <Button x:Name="CopyButton" Style="{StaticResource IconButtonStyle}" Click="Copy_Click" IsEnabled="False" ToolTipService.ToolTip="Copy recognized text"><FontIcon Glyph="&#xE8C8;" FontSize="13"/></Button>
                                <Button x:Name="OpenOutputButton" Style="{StaticResource IconButtonStyle}" Click="OpenOutput_Click" IsEnabled="False" ToolTipService.ToolTip="Open OCR output"><FontIcon Glyph="&#xE8A7;" FontSize="13"/></Button>
                                <Rectangle Width="1" Height="22" Fill="{ThemeResource AppStrokeBrush}" Margin="3,0"/>
                                <Button Style="{StaticResource IconButtonStyle}" Click="Rotate_Click" ToolTipService.ToolTip="Rotate right"><FontIcon Glyph="&#xE7AD;" FontSize="13"/></Button>
                                <Button Style="{StaticResource IconButtonStyle}" Click="ZoomOut_Click" Content="−"/>
                                <TextBlock x:Name="ZoomText" Text="100%" Width="42" TextAlignment="Center" VerticalAlignment="Center" FontSize="10"/>
                                <Button Style="{StaticResource IconButtonStyle}" Click="ZoomIn_Click" Content="+"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Background="#12000000">
                            <ScrollViewer x:Name="PreviewScroller" HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ZoomMode="Disabled">
                                <Grid x:Name="PreviewSurface" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28">
                                    <Image x:Name="PreviewImage" Stretch="Uniform" MaxWidth="1200" MaxHeight="1200" ImageOpened="PreviewImage_ImageOpened"/>
                                    <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False"/>
                                </Grid>
                            </ScrollViewer>
                            <ProgressRing x:Name="PreviewBusy" Width="38" Height="38" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Grid.Row="2" Padding="14,7" BorderBrush="{ThemeResource AppStrokeBrush}" BorderThickness="0,1,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="7"><Button Style="{StaticResource IconButtonStyle}" Click="PreviousPage_Click" Content="‹"/><TextBlock VerticalAlignment="Center"><Run Text="Page "/><Run x:Name="PageNowRun" Text="1"/><Run Text=" of "/><Run x:Name="PageTotalRun" Text="1"/></TextBlock><Button Style="{StaticResource IconButtonStyle}" Click="NextPage_Click" Content="›"/></StackPanel>
                            <ComboBox x:Name="FileQualityCombo" Grid.Column="2" Width="170" SelectionChanged="FileQuality_SelectionChanged" SelectedIndex="0">
                                <ComboBoxItem Content="Use global setting" Tag="inherit"/><ComboBoxItem Content="Fast" Tag="fast"/><ComboBoxItem Content="Balanced" Tag="balanced"/><ComboBoxItem Content="Best" Tag="best"/>
                            </ComboBox>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="DropOverlay" Grid.Row="1" Background="#B0121520" Visibility="Collapsed" CornerRadius="20" Margin="22" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2" IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"><Border Width="56" Height="56" CornerRadius="18" Background="{ThemeResource AccentFillColorDefaultBrush}"><FontIcon Glyph="&#xE710;" FontSize="24" Foreground="White"/></Border><TextBlock Text="Drop to add files" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Release anywhere in PortableOCR" Foreground="{ThemeResource AppTextSecondaryBrush}" HorizontalAlignment="Center"/></StackPanel>
        </Border>
    </Grid>
</Window>
